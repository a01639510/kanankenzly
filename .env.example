# Copia este archivo a .env.local y llena los valores.
# .env.local está en .gitignore: nunca se sube al repo.

# --- Supabase -------------------------------------------------------------
# Project Settings > API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor y scripts. NUNCA la expongas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox ---------------------------------------------------------------
# Token público (pk.…) para los mapas de GeoSIC y Satélite.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.

# --- Copernicus Data Space (Sentinel-2) -----------------------------------
# Gratis y global. Se generan en:
#   https://shapps.dataspace.copernicus.eu/dashboard -> User settings
# Sin prefijo NEXT_PUBLIC: se usan solo desde el servidor.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Organización (tenant) ------------------------------------------------
# Slug de la organización con la que trabajan los scripts. Debe coincidir con
# el v_org_slug del bootstrap en supabase/migrations/0002_storage_and_bootstrap.sql
ORG_SLUG=demo

# --- Mapa -----------------------------------------------------------------
# Centro por defecto "lng,lat" cuando la organización aún no tiene polígonos.
# Si se omite, cae en el eje cafetero de Colombia (-75.5, 4.6).
NEXT_PUBLIC_MAPA_CENTRO=-75.5,4.6
